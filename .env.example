# Development credentials. Copy to .env and fill in locally; never commit .env.
# Apple Account email for CalDAV and CardDAV.
ICLOUD_APPLE_ID=
# iCloud Mail address; it may differ from the Apple Account email.
ICLOUD_MAIL_USER=
# App-specific password from account.apple.com, never the main account password.
ICLOUD_APP_PASSWORD=
# Optional settings.
ICLOUD_TIMEZONE=Europe/Berlin
ICLOUD_DEFAULT_CALENDAR=
ICLOUD_CHATGPT_MODE=readonly
